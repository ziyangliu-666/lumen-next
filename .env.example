# Copy to .env. Never commit .env.
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen
# The server. Vite serves the pages on 4173 in development and proxies /api and /ws here.
LUMEN_PORT=4000
LUMEN_ORIGIN=http://localhost:4173 # Exact browser origin; staging uses http://localhost:4000.
IDENTITY_SESSION_LIFETIME_MS=86400000 # Login session lifetime in milliseconds.
IDENTITY_INSECURE_COOKIES=true # Loopback HTTP only; use false with production HTTPS.
LUMEN_LOG_LEVEL=info # trace, debug, info, warn, error, fatal, silent. See docs/LOGGING.md.
# Where SandboxFs stores project files. Defaults to .data next to the running
# server if unset — set this for a real deploy, where that should be a mounted volume.
LUMEN_VOLUME_ROOT=
# "steering" runs steering's own agent loop instead of the demo worker. Unset
# (or anything else) keeps the demo worker, which is still what CI's
# e2e.test.ts and the rest of the team's staging runs are built against.
LUMEN_WORKER=
# Which Compute a reader's command runs against: "docker" or "none" (default).
# "none" needs no Docker; every run answers with NullCompute's readable failure.
LUMEN_COMPUTE_PROVIDER=
LUMEN_LOG_LEVEL=info # Fastify log level: trace, debug, info, warn, error, fatal.

# Where sign-in mail goes: off (default) sends nothing and hides the mail routes;
# outbox writes each message to a local folder instead of sending it; resend
# sends it for real and needs the two below. Any mode but off needs the key.
IDENTITY_MAIL_MODE=off
# Server-only HMAC key for the mail queue, at least 32 characters. Never commit one.
IDENTITY_MAIL_KEY=
MAIL_FROM=
RESEND_API_KEY=

# Slice secrets — each owner fills their own, none are committed.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# How long each step of the demo worker pretends to work, in ms (0 to 10000).
# The demo worker runs until the steering slice supplies the real agent loop.
LUMEN_DEMO_PACE_MS=900
# The language model the lead thinks and replies with: openai, deepseek, or none
# (default). The key comes from the vendor's usual variable. LUMEN_MODEL names
# the model; unset, each vendor's cheapest is used (gpt-4.1-nano, deepseek-flash).
LUMEN_MODEL_PROVIDER=none
LUMEN_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Where each vendor is reached. Unset, its own API is used. OPENAI_BASE_URL also
# points the openai provider at any OpenAI-compatible endpoint; a model it serves
# still needs a row in apps/server/src/core/model/pricing.ts, or its calls fail.
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=
