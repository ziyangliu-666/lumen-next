# Copy to .env. Never commit .env.
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen
# The server. Vite serves the pages on 4173 in development and proxies /api and /ws here.
LUMEN_PORT=4000
LUMEN_ORIGIN=http://localhost:4173 # Exact browser origin; staging uses http://localhost:4000.
IDENTITY_SESSION_LIFETIME_MS=86400000 # Login session lifetime in milliseconds.
IDENTITY_INSECURE_COOKIES=true # Loopback HTTP only; use false with production HTTPS.

# Slice secrets — each owner fills their own, none are committed.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
