+
+export class RequestFailure extends Error {
+  constructor(
+    readonly status: number,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+export async function request<T>(url: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(url, init);
+  if (!response.ok) {
+    let message =
+      response.status === 401
+        ? 'Sign in to see your projects.'
+        : `Request failed (${response.status}). Please try refreshing.`;
+    try {
+      const body: unknown = await response.json();
+      if (body && typeof body === 'object' && 'error' in body && typeof body.error === 'string')
+        message = body.error;
+    } catch {
+      /* Use the status when the response is not JSON. */
+    }
+    throw new RequestFailure(response.status, message);
+  }
+  return (await response.json()) as T;
+}
+
+export function createProjectRequest(question: string, mode: 'explore' | 'seed'): Promise<Response> {
+  return fetch('/api/projects', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ question, mode }) });
+}
