# Copy to .env. Never commit .env.

# Server
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen # Unset: everything in memory.
LUMEN_PORT=4000
LUMEN_ORIGIN=http://localhost:4173 # The exact origin the browser loads the app from.
LUMEN_LOG_LEVEL=info # trace, debug, info, warn, error, fatal, silent
LUMEN_VOLUME_ROOT= # Where project files live. Unset: .data next to the server.

# Sign-in
IDENTITY_SESSION_LIFETIME_MS=86400000
IDENTITY_INSECURE_COOKIES=true # true only for plain HTTP on localhost
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email (docs/mail.md)
IDENTITY_MAIL_MODE=off # off, outbox or resend
IDENTITY_MAIL_KEY=
MAIL_FROM=
RESEND_API_KEY=

# Models
LUMEN_MODEL_PROVIDER=none # openai, deepseek or none
LUMEN_MODEL= # Unset: the provider's cheapest model.
LUMEN_MODELS= # Comma-separated models a person may pick, e.g. gpt-4.1-mini,gpt-4.1
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_BASE_URL= # Any OpenAI-compatible endpoint. Its models need a price in core/model/pricing.ts.
DEEPSEEK_BASE_URL=

# Agents and sandbox
LUMEN_WORKER= # demo (default, no model needed) or steering, the real agents
LUMEN_COMPUTE_PROVIDER= # docker, or none (default: commands are refused)
LUMEN_SANDBOX_IMAGE= # The image a command runs in, e.g. python:3.12-slim-bookworm
LUMEN_SANDBOX_LIBS= # A folder of Python packages mounted into it (see Dockerfile)
LUMEN_DEMO_PACE_MS=900 # How long each demo step takes, 0 to 10000

# Billing
BILLING_SECRET_KEYRING= # JSON: key id to a base64 32-byte key, to store personal API keys
BILLING_SECRET_ACTIVE_KEY_ID=
STRIPE_SECRET_KEY= # sk_test_ only; both Stripe values, or neither
STRIPE_WEBHOOK_SECRET=
